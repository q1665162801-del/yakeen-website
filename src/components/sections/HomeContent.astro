---
/**
 * HomeContent.astro — Shared homepage body.
 * ponytail: redesigned to match FAQ page style — clean sections, no hero image,
 * eyebrow + heading + subtitle pattern, text-focused content.
 * Both / and /ar/ render this component.
 */
import { getAllProducts } from '../../data/products';
import ProductCard from '../ProductCard.astro';
import TrustBar from '../TrustBar.astro';
import AISearchBar from '../AISearchBar.astro';
import CTABanner from '../CTABanner.astro';
import FactoryVideo from './FactoryVideo.astro';
import { getLocale, t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const prefix = locale === 'ar' ? '/ar' : '';

const products = await getAllProducts();

// ponytail: categories with images
const categories = [
  { id: 'indoor', titleKey: 'home.cat.indoor.title', descKey: 'home.cat.indoor.desc', img: '/assets/images/categories/cat-indoor.jpg' },
  { id: 'track', titleKey: 'home.cat.track.title', descKey: 'home.cat.track.desc', img: '/assets/images/categories/cat-track.jpg' },
  { id: 'panel-linear', titleKey: 'home.cat.panel-linear.title', descKey: 'home.cat.panel-linear.desc', img: '/assets/images/categories/cat-panel.jpg' },
  { id: 'industrial', titleKey: 'home.cat.industrial.title', descKey: 'home.cat.industrial.desc', img: '/assets/images/categories/cat-industrial.jpg' },
  { id: 'outdoor', titleKey: 'home.cat.outdoor.title', descKey: 'home.cat.outdoor.desc', img: '/assets/images/categories/cat-outdoor.jpg' },
];

const testimonials = [
  { id: 1, badgeKey: 'testimonials.t1.badge', textKey: 'testimonials.t1.text', nameKey: 'testimonials.t1.name', roleKey: 'testimonials.t1.role' },
  { id: 2, badgeKey: 'testimonials.t2.badge', textKey: 'testimonials.t2.text', nameKey: 'testimonials.t2.name', roleKey: 'testimonials.t2.role' },
  { id: 3, badgeKey: 'testimonials.t3.badge', textKey: 'testimonials.t3.text', nameKey: 'testimonials.t3.name', roleKey: 'testimonials.t3.role' },
];

const whyItems = [
  { icon: '🏭', titleKey: 'whyYakeen.manufacturing', descKey: 'whyYakeen.manufacturingDesc' },
  { icon: '📋', titleKey: 'whyYakeen.certified', descKey: 'whyYakeen.certifiedDesc' },
  { icon: '🔧', titleKey: 'whyYakeen.customization', descKey: 'whyYakeen.customizationDesc' },
  { icon: '🚢', titleKey: 'whyYakeen.delivery', descKey: 'whyYakeen.deliveryDesc' },
];
---

<!-- ===== Hero Section — redesigned with design flair ===== -->
<section class="relative overflow-hidden section-padding" style="background: linear-gradient(180deg, rgba(5,11,20,0.45) 0%, rgba(5,11,20,0.20) 35%, rgba(5,11,20,0.55) 100%), url('/assets/images/hero/hero-bright-elegant.webp') center/cover no-repeat;">

  <!-- ponytail: decorative gradient orbs for depth — big company feel -->
  <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full opacity-10 blur-3xl pointer-events-none" style="background: radial-gradient(circle, #c9a961 0%, transparent 70%);"></div>
  <div class="absolute bottom-1/4 right-1/4 w-80 h-80 rounded-full opacity-[0.07] blur-3xl pointer-events-none" style="background: radial-gradient(circle, #3a5685 0%, transparent 70%);"></div>

  <div class="container-yakeen relative z-10">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Badge — glassmorphism with gold accent lines -->
      <div class="reveal flex items-center justify-center gap-3 mb-8">
        <span class="h-px w-8 md:w-12 bg-gradient-to-r from-transparent to-gold-500/50"></span>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full" style="background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid rgba(201,169,97,0.25);">
          <span class="w-1.5 h-1.5 rounded-full bg-gold-500 animate-pulse"></span>
          <span class="text-white/90 text-xs font-semibold tracking-widest uppercase">{t(locale, 'hero.badge')}</span>
        </div>
        <span class="h-px w-8 md:w-12 bg-gradient-to-l from-transparent to-gold-500/50"></span>
      </div>

      <!-- Heading — gradient text with glow, tight tracking -->
      <h1 class="reveal hero-title-gradient text-4xl md:text-5xl lg:text-[3.5rem] font-bold leading-[1.12] mb-5 tracking-tight px-2">
        {t(locale, 'hero.title')}
      </h1>

      <!-- Diamond separator — small design detail -->
      <div class="reveal flex items-center justify-center gap-2.5 mb-6">
        <span class="h-px w-10 bg-gold-500/25"></span>
        <span class="w-1.5 h-1.5 rotate-45 bg-gold-500/40"></span>
        <span class="h-px w-10 bg-gold-500/25"></span>
      </div>

      <!-- Subtitle -->
      <p class="reveal text-lg md:text-xl text-white/75 mb-10 max-w-2xl mx-auto leading-relaxed">
        {t(locale, 'hero.subtitle')}
      </p>

      <!-- AI Search — focal point -->
      <div class="reveal mb-8">
        <AISearchBar products={products} />
      </div>

      <!-- CTA buttons -->
      <div class="reveal flex flex-wrap justify-center gap-4">
        <a href={prefix + '/contact'} class="btn-gold animate-pulse-gold text-base px-8 py-4">
          {t(locale, 'hero.getQuote')}
        </a>
        <a href={prefix + '/products'} class="btn-outline-gold text-base px-8 py-4">
          {t(locale, 'hero.browseProducts')}
        </a>
      </div>
    </div>
  </div>

  <!-- ponytail: scroll-down indicator — animated chevron at hero bottom -->
  <a href="#trust-bar" class="scroll-indicator absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white/60 hover:text-gold-400 transition-colors" aria-label="Scroll down">
    <span class="text-xs uppercase tracking-widest">{locale === 'ar' ? 'اسحب للأسفل' : 'Scroll'}</span>
    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </a>
</section>

<!-- ===== Trust Bar ===== -->
<div id="trust-bar"><TrustBar /></div>

<!-- ===== Product Categories — clean text cards, no images (FAQ-style) ===== -->
<section class="section-padding" style="background: var(--sand-50);">
  <div class="container-yakeen">
    <!-- Section header — eyebrow + heading + subtitle (FAQ pattern) -->
    <div class="mb-12 reveal text-center">
      <p class="text-gold-600 font-bold tracking-widest uppercase text-xs mb-3">{t(locale, 'products.eyebrow')}</p>
      <h2 class="text-3xl md:text-5xl font-bold text-navy-900 leading-tight">{t(locale, 'products.title')}</h2>
      <p class="text-gray-500 mt-4 max-w-xl mx-auto text-lg">{t(locale, 'products.subtitle')}</p>
    </div>

    {/* Category cards — with images, alternating reveal directions */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-12">
      {categories.map((cat, i) => (
        <a
          href={prefix + '/products?cat=' + cat.id}
          class={`${i % 2 === 0 ? 'reveal-left' : 'reveal-right'} group relative overflow-hidden rounded-xl aspect-[4/3] card-premium`}
          style={`transition-delay: ${i * 60}ms`}
        >
          <img src={cat.img} alt={t(locale, cat.titleKey)} loading="lazy" width="400" height="300" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 bg-gradient-to-t from-navy-900/70 via-navy-900/20 to-transparent"></div>
          <div class="relative z-10 p-5 flex flex-col justify-end h-full">
            <h3 class="font-bold text-white text-sm group-hover:text-gold-400 transition-colors duration-300">{t(locale, cat.titleKey)}</h3>
            <p class="text-white/70 text-xs mt-1">{t(locale, cat.descKey)}</p>
          </div>
        </a>
      ))}
    </div>

    {/* Featured products */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {products.filter(p => p.featured).map((product) => (
        <ProductCard product={product} />
      ))}
    </div>

    <div class="text-center mt-12 reveal">
      <a href={prefix + '/products'} class="btn-outline-gold">
        {t(locale, 'hero.browseProducts')} →
      </a>
    </div>
  </div>
</section>

<!-- ===== Why Choose Yakeen — light, clean cards ===== -->
<section class="section-padding relative" style="background: #ffffff;">
  <div class="container-yakeen relative z-10 pt-8">
    <div class="mb-16 reveal text-center">
      <p class="text-gold-600 font-bold tracking-widest uppercase text-xs mb-3">{t(locale, 'whyYakeen.eyebrow')}</p>
      <h2 class="text-3xl md:text-5xl font-bold text-navy-900 leading-tight">{t(locale, 'whyYakeen.title')}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {whyItems.map((item, i) => (
        <div class="reveal-scale card-premium p-8" style={`transition-delay: ${i * 80}ms`}>
          <div class="text-4xl mb-5">{item.icon}</div>
          <h3 class="text-navy-900 font-bold text-lg mb-2">{t(locale, item.titleKey)}</h3>
          <p class="text-gray-500 text-sm leading-relaxed">{t(locale, item.descKey)}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== Factory Tour Video ===== -->
<FactoryVideo />

<!-- ===== Customer Testimonials — text only, no images (FAQ-style) ===== -->
<section class="section-padding relative" style="background: var(--sand-50);">
  <div class="container-yakeen relative z-10 pt-8">
    <div class="mb-16 reveal text-center">
      <p class="text-gold-600 font-bold tracking-widest uppercase text-xs mb-3">{t(locale, 'testimonials.eyebrow')}</p>
      <h2 class="text-3xl md:text-5xl font-bold text-navy-900 leading-tight">{t(locale, 'testimonials.title')}</h2>
      <p class="text-gray-500 mt-4 max-w-xl mx-auto text-lg">{t(locale, 'testimonials.subtitle')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {testimonials.map((testimonial, i) => (
        <div class={`${i % 2 === 0 ? 'reveal-left' : 'reveal-right'} card-premium p-8`} style={`transition-delay: ${i * 80}ms`}>
          <span class="text-gold-500 text-xs font-bold uppercase tracking-widest">{t(locale, testimonial.badgeKey)}</span>
          <div class="text-gold-500 mt-3 text-lg">★★★★★</div>
          <p class="text-gray-700 mt-4 leading-relaxed text-sm">{t(locale, testimonial.textKey)}</p>
          <div class="mt-6 pt-5 border-t border-gray-100">
            <div class="font-bold text-navy-900 text-sm">{t(locale, testimonial.nameKey)}</div>
            <div class="text-xs text-gray-500">{t(locale, testimonial.roleKey)}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== CTA Banner ===== -->
<CTABanner />

<style>
  /* ponytail: gradient title — white→cream→gold, subtle glow, slow shimmer */
  .hero-title-gradient {
    letter-spacing: -0.03em;
    background: linear-gradient(135deg, #ffffff 0%, #f5ecd9 35%, #d4b576 65%, #c9a961 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 2px 20px rgba(201,169,97,0.15));
    animation: hero-shimmer 8s ease-in-out infinite;
  }
  @keyframes hero-shimmer {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  /* ponytail: reduced-motion — disable shimmer for accessibility */
  @media (prefers-reduced-motion: reduce) {
    .hero-title-gradient { animation: none; }
  }
</style>
