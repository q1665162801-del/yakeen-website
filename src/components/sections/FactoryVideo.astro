---
/**
 * FactoryVideo.astro — Premium factory tour video section.
 * YouTube lazy-load: only loads iframe on click. Zero impact on initial page speed.
 */
import { getLocale, t } from '../../i18n/ui';

const locale = getLocale(Astro.url);
const prefix = locale === 'ar' ? '/ar' : '';

const videoId = '7WOLY5ePp9Y';
const coverImg = '/assets/images/factory/factory-video-cover.jpg';
---

<section class="factory-video-section section-padding" style="background: linear-gradient(180deg, #050b14 0%, #0a1525 50%, #050b14 100%);">
  <!-- Decorative orbs matching hero -->
  <div class="absolute top-1/4 right-1/4 w-96 h-96 rounded-full opacity-[0.06] blur-3xl pointer-events-none" style="background: radial-gradient(circle, #c9a961 0%, transparent 70%);"></div>
  <div class="absolute bottom-1/4 left-1/4 w-80 h-80 rounded-full opacity-[0.05] blur-3xl pointer-events-none" style="background: radial-gradient(circle, #3a5685 0%, transparent 70%);"></div>

  <div class="container-yakeen relative z-10">
    <!-- Section header -->
    <div class="text-center mb-10 reveal">
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="h-px w-8 md:w-12 bg-gradient-to-r from-transparent to-gold-500/50"></span>
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full" style="background: rgba(255,255,255,0.06); backdrop-filter: blur(10px); border: 1px solid rgba(201,169,97,0.2);">
          <span class="w-1.5 h-1.5 rounded-full bg-gold-500 animate-pulse"></span>
          <span class="text-white/80 text-xs font-semibold tracking-widest uppercase">
            {locale === 'ar' ? 'جولة المصنع' : 'Factory Tour'}
          </span>
        </div>
        <span class="h-px w-8 md:w-12 bg-gradient-to-l from-transparent to-gold-500/50"></span>
      </div>
      <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-4">
        {locale === 'ar' ? 'شاهد المصنع بنفسك' : 'See the Factory Yourself'}
      </h2>
      <p class="text-white/60 text-lg max-w-2xl mx-auto leading-relaxed">
        {locale === 'ar'
          ? 'من خط إنتاج SMT إلى مختبر الاختبار وجودة التحكم — شاهد كيف نصنع منتجات إضاءة Yakeen'
          : 'From SMT production lines to testing labs and QC — watch how Yakeen lighting products are made'}
      </p>
    </div>

    <!-- Video player — lazy loaded, full-width with padding -->
    <div class="w-full max-w-[1400px] mx-auto px-4 md:px-8 reveal">
      <div
        class="video-wrapper relative aspect-video rounded-2xl overflow-hidden cursor-pointer group shadow-2xl"
        style="border: 1px solid rgba(201,169,97,0.15);"
        data-youtube={videoId}
        role="button"
        tabindex="0"
        aria-label={locale === 'ar' ? 'تشغيل جولة المصنع' : 'Play factory tour video'}
      >
        <!-- Cover image -->
        <img
          src={coverImg}
          alt={locale === 'ar' ? 'جولة مصنع Yakeen' : 'Yakeen Factory Tour'}
          loading="lazy"
          width="1280"
          height="720"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />

        <!-- Dark overlay for contrast -->
        <div class="absolute inset-0 bg-gradient-to-t from-navy-900/80 via-navy-900/30 to-navy-900/20"></div>

        <!-- Play button — gold gradient, pulsing -->
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="play-btn-wrapper relative">
            <!-- Pulse ring -->
            <div class="absolute inset-0 rounded-full bg-gold-500/20 animate-ping-slow"></div>
            <!-- Button -->
            <div class="relative w-20 h-20 md:w-24 md:h-24 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110"
              style="background: linear-gradient(135deg, #c9a961 0%, #d4b576 50%, #b8941f 100%); box-shadow: 0 8px 32px rgba(201,169,97,0.4), inset 0 2px 4px rgba(255,255,255,0.2);">
              <svg class="w-8 h-8 md:w-10 md:h-10 text-navy-900 ml-1" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5v14l11-7z" />
              </svg>
            </div>
          </div>
        </div>

        <!-- Bottom label bar -->
        <div class="absolute bottom-0 left-0 right-0 p-4 md:p-6 flex items-center justify-between" style="background: linear-gradient(0deg, rgba(5,11,20,0.9) 0%, transparent 100%);">
          <div class="flex items-center gap-3">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            <span class="text-white/90 text-sm font-medium">
              {locale === 'ar' ? 'Yakeen Lighting — جولة المصنع' : 'Yakeen Lighting — Factory Tour'}
            </span>
          </div>
          <span class="text-white/50 text-xs hidden sm:block">
            {locale === 'ar' ? 'اضغط للمشاهدة' : 'Click to play'} ▶
          </span>
        </div>
      </div>

      <!-- Trust indicators below video -->
      <div class="grid grid-cols-3 gap-4 mt-8">
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-gradient-gold">SMT</div>
          <div class="text-white/50 text-xs mt-1 uppercase tracking-wide">
            {locale === 'ar' ? 'خط الإنتاج' : 'Production Line'}
          </div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-gradient-gold">5-Stage</div>
          <div class="text-white/50 text-xs mt-1 uppercase tracking-wide">
            {locale === 'ar' ? 'مراقبة الجودة' : 'QC Inspection'}
          </div>
        </div>
        <div class="text-center">
          <div class="text-2xl md:text-3xl font-bold text-gradient-gold">SASO</div>
          <div class="text-white/50 text-xs mt-1 uppercase tracking-wide">
            {locale === 'ar' ? 'معتمد' : 'Certified'}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .factory-video-section {
    position: relative;
    overflow: hidden;
  }
  /* Slow pulse for play button ring */
  @keyframes ping-slow {
    0% { transform: scale(1); opacity: 0.4; }
    50% { transform: scale(1.15); opacity: 0.1; }
    100% { transform: scale(1); opacity: 0.4; }
  }
  .animate-ping-slow {
    animation: ping-slow 2.5s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-ping-slow { animation: none; }
  }
  /* Video iframe fills container after click */
  .video-wrapper iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  // Lazy-load YouTube: only injects iframe on click — zero initial page weight
  document.querySelectorAll('.video-wrapper[data-youtube]').forEach((el) => {
    const activate = () => {
      if (el.querySelector('iframe')) return;
      const id = el.dataset.youtube;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      iframe.title = 'Yakeen Lighting Factory Tour';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      // Inline styles — necessary because Astro scopes CSS and dynamically created iframes don't get scoped attributes
      iframe.style.position = 'absolute';
      iframe.style.inset = '0';
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.border = '0';
      // Hide cover image and overlays
      el.querySelectorAll('img, .absolute').forEach((n) => (n.style.display = 'none'));
      el.appendChild(iframe);
    };
    el.addEventListener('click', activate);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); }
    });
  });
</script>
