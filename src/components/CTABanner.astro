---
/**
 * CTABanner.astro
 * Conversion-focused call-to-action banner with a solid navy background.
 * Build-time i18n — all text resolved at compile time, zero runtime JS.
 */

import { getLocale, t } from '../i18n/ui';

const locale = getLocale(Astro.url);
const prefix = locale === 'ar' ? '/ar' : '';

export interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = t(locale, 'cta.title'),
  subtitle = t(locale, 'cta.subtitle'),
} = Astro.props;
---

<section class="relative overflow-hidden">
  {/* Solid navy background */}
  <div
    class="cta-bg relative mx-auto my-16 max-w-6xl px-6 py-16 text-center md:my-24 md:px-12 md:py-24"
  >
    {/* Decorative gold glow */}
    <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-gold-500/15 blur-3xl"></div>

    <div class="relative">
      <h2 class="font-serif text-3xl font-bold text-white md:text-4xl lg:text-5xl">
        {title}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-white/80 md:text-lg">
        {subtitle}
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        {/* Primary gold CTA */}
        <a
          href={prefix + '/contact'}
          class="btn-gold animate-pulse-gold w-full sm:w-auto"
        >
          {t(locale, 'cta.button')}
          <svg
            class="ml-1.5 h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>

        {/* Secondary outline CTA */}
        <a
          href={prefix + '/about'}
          class="btn-outline-gold w-full sm:w-auto"
        >
          <svg
            class="mr-2 h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
            />
          </svg>
          {t(locale, 'cta.watchFactory')}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-bg {
    background: #0a1525;
    border-radius: 1.5rem;
    border: 1px solid rgba(201, 169, 97, 0.25);
    box-shadow: 0 20px 60px -20px rgba(5, 11, 20, 0.6);
  }
</style>
