---
/**
 * ProductSpecs.astro
 * Technical specification table for a product detail page.
 *
 * Renders all 12 spec rows: Wattage, Luminous Efficacy, Color Temperature,
 * CRI, Beam Angle, IP Rating, Dimming, Lifespan, Warranty, Certifications,
 * MOQ, and Lead Time.
 *
 * Responsive: a zebra-striped table on tablet/desktop, collapses to a
 * stacked label/value card list on mobile.
 */

import type { ProductSpec } from '@data/products';
import { getLocale, t, trSpec } from '../i18n/ui';

export interface Props {
  specs: ProductSpec;
}

const { specs } = Astro.props;
const locale = getLocale(Astro.url);

// Ordered list of (key, value) pairs — labels resolved via i18n at render time.
const specRows: { key: string; value: string }[] = [
  { key: 'product.specs.wattage', value: specs.wattage },
  { key: 'product.specs.efficacy', value: specs.efficacy },
  { key: 'product.specs.colorTemp', value: specs.cct },
  { key: 'product.specs.cri', value: specs.cri },
  { key: 'product.specs.beamAngle', value: specs.beamAngle },
  { key: 'product.specs.ipRating', value: specs.ipRating },
  { key: 'product.specs.dimming', value: trSpec(locale, specs.dimming) },
  { key: 'product.specs.lifespan', value: trSpec(locale, specs.lifespan) },
  { key: 'product.specs.warranty', value: trSpec(locale, specs.warranty) },
  { key: 'product.specs.certifications', value: specs.certifications },
  { key: 'product.specs.moq', value: trSpec(locale, specs.moq) },
  { key: 'product.specs.leadTime', value: trSpec(locale, specs.leadTime) },
];
---

<section class="specs-section" aria-labelledby="specs-heading">
  <h2 id="specs-heading" class="mb-6 font-serif text-2xl font-bold text-navy-900 md:text-3xl">
    {t(locale, 'product.specs.title')}
  </h2>

  {/* Responsive spec table */}
  <div class="overflow-hidden rounded-2xl border border-navy-100 bg-white">
    <table class="specs-table w-full text-left">
      <caption class="sr-only">
        {t(locale, 'product.specs.caption')}
      </caption>
      <thead class="hidden md:table-header-group">
        <tr class="bg-navy-900 text-white">
          <th scope="col" class="w-1/3 px-6 py-4 text-sm font-semibold uppercase tracking-wide">
            {t(locale, 'product.specs.parameter')}
          </th>
          <th scope="col" class="px-6 py-4 text-sm font-semibold uppercase tracking-wide">
            {t(locale, 'product.specs.value')}
          </th>
        </tr>
      </thead>
      <tbody>
        {specRows.map((row, index) => (
          <tr
            class={`specs-row ${
              index % 2 === 0 ? 'bg-white' : 'bg-sand-50'
            } md:border-b md:border-navy-100 last:border-b-0`}
          >
            <th
              scope="row"
              class="px-5 py-3 text-sm font-semibold text-navy-700 md:px-6 md:py-4 md:w-1/3"
            >
              {t(locale, row.key)}
            </th>
            <td class="px-5 py-3 text-sm text-navy-900 md:px-6 md:py-4">
              {row.value}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  /* On mobile the table behaves as stacked label/value rows */
  .specs-table tbody {
    display: block;
  }
  .specs-table tr {
    display: block;
  }
  .specs-table th,
  .specs-table td {
    display: block;
  }
  .specs-table th {
    padding-top: 0.75rem;
    padding-bottom: 0;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--gold-600);
  }
  .specs-table td {
    padding-top: 0.125rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--sand-100);
  }
  .specs-table tr:last-child td {
    border-bottom: none;
  }

  /* Tablet and up: real two-column table rows */
  @media (min-width: 768px) {
    .specs-table {
      display: table;
      table-layout: fixed;
    }
    .specs-table thead,
    .specs-table tbody,
    .specs-table tr,
    .specs-table th,
    .specs-table td {
      display: revert;
    }
    .specs-table th {
      font-size: 0.875rem;
      text-transform: none;
      letter-spacing: 0;
      color: revert;
      padding: 1rem 1.5rem;
      padding-bottom: 1rem;
    }
    .specs-table td {
      padding: 1rem 1.5rem;
      border-bottom: none;
    }
  }
</style>
