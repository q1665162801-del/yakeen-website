---
/**
 * AISearchBar.astro
 * Hero AI-powered search bar.
 *
 * Layout:
 *  - White rounded search box with a gold border
 *  - Search icon + text input + "AI Search" gold button
 *  - Quick-search chips below: Downlight UGR<19, Panel 600x600, IP65 Flood, Solar Street
 *
 * Behavior:
 *  - Typing a query and submitting (Enter or button) redirects to
 *    /ai-assistant?search=<query>
 *  - Clicking a quick-search chip runs quickSearch() with that term
 *  - Exposes handleHeroSearch() and quickSearch() for reuse/testability
 */

import { getLocale, t } from '../i18n/ui';

export interface Props {
  /** Optional placeholder text for the input */
  placeholder?: string;
}

const locale = getLocale(Astro.url);
const { placeholder } = Astro.props;
const placeholderText = placeholder || t(locale, 'ai.search.placeholder');

// Quick-search suggestion chips — i18n driven
const quickSearches = [
  t(locale, 'ai.search.quick1'),
  t(locale, 'ai.search.quick2'),
  t(locale, 'ai.search.quick3'),
  t(locale, 'ai.search.quick4'),
];
---

<div class="ai-search-bar mx-auto w-full max-w-3xl">
  <form
    id="ai-search-form"
    class="flex items-center gap-2 rounded-full border-2 border-gold-500 bg-white p-2 shadow-lg shadow-navy-900/10 transition-shadow focus-within:shadow-xl focus-within:shadow-gold-500/20"
    role="search"
    aria-label={t(locale, 'aria.aiSearch')}
  >
    {/* Search icon */}
    <span class="flex h-10 w-10 shrink-0 items-center justify-center pl-1 text-navy-500">
      <svg
        class="h-5 w-5"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
        />
      </svg>
    </span>

    {/* Input */}
    <input
      id="ai-search-input"
      type="search"
      name="search"
      placeholder={placeholderText}
      autocomplete="off"
      aria-label={t(locale, 'aria.searchProducts')}
      class="min-w-0 flex-1 bg-transparent text-sm text-navy-900 placeholder:text-navy-400 focus:outline-none md:text-base"
    />

    {/* AI Search button */}
    <button
      type="submit"
      class="btn-gold shrink-0"
    >
      <svg
        class="mr-1.5 h-4 w-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
      {t(locale, 'ai.search.button')}
    </button>
  </form>

  {/* Quick-search chips */}
  <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
    <span class="text-sm font-medium uppercase tracking-wide text-white/95">
      {t(locale, 'ai.search.quickSearch')}
    </span>
    {quickSearches.map((term) => (
      <button
        type="button"
        data-quick-search={term}
        class="quick-chip rounded-full border border-gold-500/60 bg-white/10 px-4 py-1.5 text-sm font-medium text-white/95 backdrop-blur-sm transition-colors hover:border-gold-500 hover:bg-gold-500 hover:text-navy-900"
      >
        {term}
      </button>
    ))}
  </div>
</div>

<script is:inline>
  (function () {
    var form = document.getElementById('ai-search-form');
    var input = document.getElementById('ai-search-input');
    var chips = document.querySelectorAll('[data-quick-search]');
    if (!form || !input) return;

    // Redirect to the AI assistant with the search query.
    // ponytail: derive prefix from current path to support /ar/ locale
    var _p = window.location.pathname.startsWith('/ar') ? '/ar' : '';
    function handleHeroSearch(query) {
      var trimmed = (query || '').trim();
      if (!trimmed) return;
      window.location.href = _p + '/ai-assistant?search=' + encodeURIComponent(trimmed);
    }

    // Fill the input with a quick-search term and submit.
    function quickSearch(term) {
      input.value = term;
      handleHeroSearch(term);
    }

    // Form submit (Enter or button click)
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      handleHeroSearch(input.value);
    });

    // Quick-search chips
    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        quickSearch(chip.getAttribute('data-quick-search'));
      });
    });

    // Expose for reuse/testing
    window.handleHeroSearch = handleHeroSearch;
    window.quickSearch = quickSearch;
  })();
</script>
