---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/sections/HomeContent.astro';
import { websiteSchema } from '../utils/schema';
import { getLocale, t } from '../i18n/ui';

const locale = getLocale(Astro.url);
const wsSchema = websiteSchema();
---
<BaseLayout
  title={t(locale, 'hero.title') + ' — Yakeen Lighting'}
  description={t(locale, 'hero.subtitle')}
  image="/assets/images/hero/hero-bright-elegant.webp"
  canonicalPath="/"
  type="page"
>
  {/* WebSite schema — enables sitelinks search box in Google SERPs */}
  <script type="application/ld+json" set:html={JSON.stringify(wsSchema)} />
  <HomeContent />
</BaseLayout>
