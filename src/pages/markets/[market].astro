---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import ProductCard from '../../components/ProductCard.astro';
import { markets, type Market } from '../../data/markets';
import { getAllProducts } from '../../data/products';
import { localBusinessSchema, breadcrumbSchema, faqPageSchema, type FaqEntry } from '../../utils/schema';
import { getLocale, t } from '../../i18n/ui';

export async function getStaticPaths() {
  return markets.map((market) => ({
    params: { market: market.slug },
    props: { market },
  }));
}

const { market } = Astro.props;
const locale = getLocale(Astro.url);
const prefix = locale === 'ar' ? '/ar' : '';

// Localized market data
const m = locale === 'ar' && market.ar ? {
  ...market,
  name: market.ar.name,
  heroTitle: market.ar.heroTitle,
  heroSubtitle: market.ar.heroSubtitle,
  summary: market.ar.summary,
  certifications: market.ar.certifications,
  projects: market.ar.projects,
  faqs: market.ar.faqs,
} : market;

// Get recommended products (first 4 by category match)
const allProducts = await getAllProducts();
const recommendedProducts = allProducts
  .filter((p) => market.recommendedCategories.some((cat) => p.category.toLowerCase().includes(cat.toLowerCase().split(' ')[1]?.toLowerCase() || '')))
  .slice(0, 4);
// ponytail: fallback if not enough matches
if (recommendedProducts.length < 4) {
  const filler = allProducts.filter((p) => !recommendedProducts.includes(p)).slice(0, 4 - recommendedProducts.length);
  recommendedProducts.push(...filler);
}

const crumbs = [
  { name: t(locale, 'nav.home'), url: prefix + '/' },
  { name: t(locale, 'nav.markets'), url: prefix + '/markets' },
  { name: m.name, url: `${prefix}/markets/${market.slug}` },
];

const localBizJsonLd = localBusinessSchema(market.name, market.countryCode);
const breadcrumbJsonLd = breadcrumbSchema(crumbs);
const faqEntries: FaqEntry[] = m.faqs.map((f) => ({ question: f.question, answer: f.answer }));
const faqJsonLd = faqPageSchema(faqEntries);
---

<BaseLayout
  title={`${market.metaTitle}`}
  description={market.metaDescription}
  canonicalPath={`/markets/${market.slug}`}
  type="page"
>
  {/* === Structured Data — LocalBusiness + Breadcrumb + FAQ (Organization is in BaseLayout) === */}
  <script type="application/ld+json" set:html={JSON.stringify(localBizJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  {/* === Breadcrumb === */}
  <section class="pt-28 pb-4" style="background: #0a1525;">
    <div class="container-yakeen">
      <nav class="text-sm text-white/60" aria-label={t(locale, 'aria.breadcrumb')}>
        <a href={prefix + '/'} class="hover:text-gold-400 transition-colors">{t(locale, 'nav.home')}</a>
        <span class="mx-2 text-white/30">/</span>
        <span class="text-gold-400 font-medium">{m.name}</span>
      </nav>
    </div>
  </section>

  {/* === Hero === */}
  <section class="relative overflow-hidden" style="background: linear-gradient(180deg, #0a1525 0%, #0f1e35 100%);">
    <div class="container-yakeen py-16 md:py-24">
      <div class="max-w-4xl reveal">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wide bg-gold-500/15 text-gold-500 mb-4">
          {market.country}
        </span>
        <h1 class="font-serif text-3xl md:text-5xl font-bold text-white leading-tight">
          {m.heroTitle}
        </h1>
        <p class="mt-4 text-lg text-white/80 leading-relaxed max-w-2xl">
          {m.heroSubtitle}
        </p>
        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href={prefix + '/contact'} class="btn-gold animate-pulse-gold">{t(locale, 'cta.button')}</a>
          <a href={prefix + '/products'} class="btn-outline-gold">{t(locale, 'hero.browseProducts')}</a>
        </div>
      </div>
    </div>
  </section>

  {/* === AI-Search Summary (conclusion-first structure) === */}
  <section class="section-padding bg-white">
    <div class="container-yakeen max-w-4xl">
      <div class="reveal">
        <h2 class="font-serif text-2xl md:text-3xl font-bold text-navy-900 mb-4">
          {locale === 'ar' ? 'نبذة' : 'Overview'}
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed">{m.summary}</p>
      </div>
    </div>
  </section>

  {/* === Certifications === */}
  <section class="section-padding" style="background: #f8f6f1;">
    <div class="container-yakeen">
      <div class="text-center mb-10 reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">
          {locale === 'ar' ? 'الشهادات' : 'Certifications & Compliance'}
        </p>
        <h2 class="text-2xl md:text-3xl font-bold text-navy-900">
          {locale === 'ar' ? 'شهادات معتمدة لهذا السوق' : 'Certified for This Market'}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-4xl mx-auto">
        {m.certifications.map((cert, i) => (
          <div class="reveal rounded-xl p-6 bg-white border border-gray-200 hover:border-gold-300 hover:shadow-lg transition-all" style={`transition-delay: ${i * 60}ms`}>
            <div class="flex items-start gap-3">
              <div class="flex-shrink-0 w-10 h-10 rounded-lg flex items-center justify-center" style="background: rgba(201,169,97,0.1);">
                <svg class="w-5 h-5 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-navy-900">{cert.name}</h3>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">{cert.desc}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* === Featured Projects === */}
  <section class="section-padding bg-white">
    <div class="container-yakeen">
      <div class="text-center mb-10 reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">
          {locale === 'ar' ? 'مشاريع' : 'Projects'}
        </p>
        <h2 class="text-2xl md:text-3xl font-bold text-navy-900">
          {locale === 'ar' ? 'مشاريع في هذا السوق' : 'Projects in This Market'}
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {m.projects.map((project, i) => (
          <div class="reveal rounded-xl p-6 border border-gray-200 hover:border-gold-300 hover:shadow-lg transition-all" style={`transition-delay: ${i * 60}ms`}>
            <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gold-500/15 text-gold-600 mb-3">{project.type}</span>
            <h3 class="font-bold text-navy-900 mb-1">{project.title}</h3>
            <p class="text-sm text-gold-600 font-medium mb-2">{project.location}</p>
            <p class="text-sm text-gray-600 leading-relaxed">{project.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* === Recommended Products === */}
  {recommendedProducts.length > 0 && (
    <section class="section-padding" style="background: #f8f6f1;">
      <div class="container-yakeen">
        <div class="text-center mb-10 reveal">
          <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">
            {locale === 'ar' ? 'منتجاتنا' : 'Products'}
          </p>
          <h2 class="text-2xl md:text-3xl font-bold text-navy-900">
            {locale === 'ar' ? 'منتجات موصى به لهذا السوق' : 'Recommended for This Market'}
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {recommendedProducts.map((rp) => (
            <ProductCard product={rp} />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* === FAQ (AI engines parse FAQPage schema) === */}
  <section class="section-padding bg-white">
    <div class="container-yakeen max-w-3xl">
      <div class="text-center mb-10 reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">
          {t(locale, 'product.faq.eyebrow')}
        </p>
        <h2 class="text-2xl md:text-3xl font-bold text-navy-900">
          {locale === 'ar' ? `أسئلة شائعة — ${m.name}` : `FAQ — ${market.name}`}
        </h2>
      </div>
      <div class="space-y-3">
        {m.faqs.map((faq) => (
          <details class="group rounded-xl border border-gray-200 overflow-hidden">
            <summary class="flex items-center justify-between cursor-pointer p-5 font-semibold text-navy-900 hover:bg-sand-50 transition-colors">
              {faq.question}
              <svg class="w-5 h-5 text-gold-500 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <div class="px-5 pb-5 text-gray-600 leading-relaxed">{faq.answer}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* === noscript fallback for AI crawlers === */}
  <noscript>
    <div style="padding: 2rem; max-width: 800px; margin: 0 auto;">
      <p style="font-size: 1.5rem; font-weight: 700;">{m.heroTitle}</p>
      <p>{m.summary}</p>
      <h2>Certifications</h2>
      <ul>
        {m.certifications.map((c) => (<li><strong>{c.name}</strong>: {c.desc}</li>))}
      </ul>
      <h2>Projects</h2>
      <ul>
        {m.projects.map((p) => (<li><strong>{p.title}</strong> — {p.location}: {p.desc}</li>))}
      </ul>
      <h2>FAQ</h2>
      {m.faqs.map((f) => (<p><strong>Q: {f.question}</strong><br />A: {f.answer}</p>))}
    </div>
  </noscript>

  <CTABanner />
</BaseLayout>
