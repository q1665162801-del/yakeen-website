---
// ponytail: AI Assistant page merged into homepage search ? redirect to /products
// Preserves SEO via canonical, redirects humans instantly
import { siteConfig } from '../data/site-config';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0; url=/products" />
    <link rel="canonical" href={`${siteConfig.url}/products`} />
    <meta name="robots" content="noindex, follow" />
    <title>Product Search - Yakeen Lighting</title>
  </head>
  <body>
    <noscript>
      <p>This page has moved. <a href="/products">Go to Products</a>.</p>
    </noscript>
    <script is:inline>window.location.replace('/products');</script>
  </body>
</html>
