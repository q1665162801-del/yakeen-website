---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../data/site-config';
import { organizationSchema, breadcrumbSchema } from '../utils/schema';
import { getLocale, t } from '../i18n/ui';

const locale = getLocale(Astro.url);
const prefix = locale === 'ar' ? '/ar' : '';

const orgSchema = organizationSchema();
const crumbs = [
  { name: t(locale, 'nav.home'), url: prefix + '/' },
  { name: t(locale, 'about.breadcrumb.about'), url: prefix + '/about' },
];
const breadcrumbJsonLd = breadcrumbSchema(crumbs);

const values = [
  { icon: 'shield', titleKey: 'about.values.honest.title', descKey: 'about.values.honest.desc' },
  { icon: 'compass', titleKey: 'about.values.middleEast.title', descKey: 'about.values.middleEast.desc' },
  { icon: 'lightbulb', titleKey: 'about.values.technical.title', descKey: 'about.values.technical.desc' },
  { icon: 'handshake', titleKey: 'about.values.partnership.title', descKey: 'about.values.partnership.desc' },
];

const stats = [
  { value: '10+', labelKey: 'about.stats.coreProducts' },
  { value: '6', labelKey: 'about.stats.gcc' },
  { value: '5', labelKey: 'about.stats.qc' },
  { value: '50°C', labelKey: 'about.stats.heatRated' },
];
---

<BaseLayout
  title={t(locale, 'about.eyebrow') + ' — Yakeen Lighting'}
  description={t(locale, 'about.heroDesc', { legalName: siteConfig.legalName })}
  image="/assets/images/hero/hero-bg-v3.jpg"
  canonicalPath="/about"
  type="page"
>
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  {/* Hero */}
  <section class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24" style="background: linear-gradient(135deg, #050b14 0%, #0a1525 50%, #1a2744 100%);">
    <div class="container-yakeen relative z-10">
      <nav class="text-sm text-white/60 mb-4" aria-label={t(locale, 'aria.breadcrumb')}>
        <a href={prefix + '/'} class="hover:text-gold-400 transition-colors">{t(locale, 'nav.home')}</a>
        <span class="mx-2 text-white/30">/</span>
        <span class="text-gold-400 font-medium">{t(locale, 'about.breadcrumb.about')}</span>
      </nav>

      <div class="max-w-3xl">
        <p class="reveal text-gold-500 font-semibold tracking-wide uppercase text-sm mb-3">{t(locale, 'about.eyebrow')}</p>
        <h1 class="reveal text-4xl md:text-5xl font-bold text-white leading-tight mb-6">
          {t(locale, 'hero.title')}
        </h1>
        <p class="reveal text-lg text-white/70 leading-relaxed">
          {t(locale, 'about.heroDesc', { legalName: siteConfig.legalName })}
        </p>
      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="border-b border-gray-100">
    <div class="container-yakeen py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((stat, i) => (
          <div class="reveal text-center" style={`transition-delay: ${i * 60}ms`}>
            <div class="text-4xl md:text-5xl font-bold text-gradient-gold">{stat.value}</div>
            <div class="text-sm text-gray-500 mt-2 uppercase tracking-wide">{t(locale, stat.labelKey)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Story */}
  <section class="section-padding bg-white">
    <div class="container-yakeen">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{t(locale, 'about.story.eyebrow')}</p>
          <h2 class="text-3xl md:text-4xl font-bold text-navy-900 mb-6">{t(locale, 'about.story.title')}</h2>
          <div class="space-y-4 text-gray-700 leading-relaxed">
            <p>{t(locale, 'about.story.p1')}</p>
            <p>{t(locale, 'about.story.p2')}</p>
            <p>{t(locale, 'about.story.p3')}</p>
          </div>
        </div>
        <div class="reveal rounded-2xl overflow-hidden shadow-xl">
          <img src="/assets/images/showroom/mixed-showroom-display.jpg" alt={t(locale, 'about.eyebrow')} loading="lazy" width="600" height="400" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  {/* Values */}
  <section class="section-padding" style="background: #f8f6f1;">
    <div class="container-yakeen">
      <div class="text-center mb-12 reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{t(locale, 'about.values.eyebrow')}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-900">{t(locale, 'about.values.title')}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {values.map((value, i) => (
          <div class="reveal rounded-xl p-6 bg-white border border-gray-200 hover:border-gold-300 hover:shadow-lg transition-all" style={`transition-delay: ${i * 80}ms`}>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-lg flex items-center justify-center" style="background: rgba(201,169,97,0.1);">
                <svg class="w-6 h-6 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-navy-900 text-lg mb-2">{t(locale, value.titleKey)}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{t(locale, value.descKey)}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Founder */}
  <section class="section-padding bg-white">
    <div class="container-yakeen">
      <div class="max-w-3xl mx-auto text-center reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{t(locale, 'about.founder.eyebrow')}</p>
        <h2 class="text-3xl font-bold text-navy-900 mb-8">{t(locale, 'about.founder.name')}</h2>
        <div class="rounded-2xl p-8 border border-gray-200" style="background: #f8f6f1;">
          <p class="text-gray-700 leading-relaxed mb-4">
            "{t(locale, 'about.founder.quote1')}"
          </p>
          <p class="text-gray-700 leading-relaxed">
            "{t(locale, 'about.founder.quote2')}"
          </p>
          <p class="mt-6 font-bold text-navy-900">{t(locale, 'about.founder.attribution')}</p>
        </div>
      </div>
    </div>
  </section>

  <TrustBar />
  <CTABanner />
</BaseLayout>
