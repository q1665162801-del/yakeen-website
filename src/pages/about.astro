---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTABanner from '../components/CTABanner.astro';
import TrustBar from '../components/TrustBar.astro';
import { siteConfig } from '../data/site-config';
import { breadcrumbSchema } from '../utils/schema';
import { getLocale, t } from '../i18n/ui';

const locale = getLocale(Astro.url);
const prefix = locale === 'ar' ? '/ar' : '';

const crumbs = [
  { name: t(locale, 'nav.home'), url: prefix + '/' },
  { name: t(locale, 'about.breadcrumb.about'), url: prefix + '/about' },
];
const breadcrumbJsonLd = breadcrumbSchema(crumbs);

const values = [
  { icon: 'shield', titleKey: 'about.values.honest.title', descKey: 'about.values.honest.desc' },
  { icon: 'compass', titleKey: 'about.values.middleEast.title', descKey: 'about.values.middleEast.desc' },
  { icon: 'lightbulb', titleKey: 'about.values.technical.title', descKey: 'about.values.technical.desc' },
  { icon: 'handshake', titleKey: 'about.values.partnership.title', descKey: 'about.values.partnership.desc' },
];

const stats = [
  { value: '10+', labelKey: 'about.stats.coreProducts' },
  { value: '6', labelKey: 'about.stats.gcc' },
  { value: '5', labelKey: 'about.stats.qc' },
  { value: '50°C', labelKey: 'about.stats.heatRated' },
];
---

<BaseLayout
  title={t(locale, 'about.eyebrow') + ' — Yakeen Lighting'}
  description={t(locale, 'about.heroDesc', { legalName: siteConfig.legalName })}
  image="/assets/images/hero/hero-bg-v3.jpg"
  canonicalPath="/about"
  type="page"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  {/* Hero */}
  <section class="relative overflow-hidden pt-32 pb-16 md:pt-40 md:pb-24" style="background: linear-gradient(135deg, #050b14 0%, #0a1525 50%, #1a2744 100%);">
    <div class="container-yakeen relative z-10">
      <nav class="text-sm text-white/60 mb-4" aria-label={t(locale, 'aria.breadcrumb')}>
        <a href={prefix + '/'} class="hover:text-gold-400 transition-colors">{t(locale, 'nav.home')}</a>
        <span class="mx-2 text-white/30">/</span>
        <span class="text-gold-400 font-medium">{t(locale, 'about.breadcrumb.about')}</span>
      </nav>

      <div class="max-w-3xl">
        <p class="reveal text-gold-500 font-semibold tracking-wide uppercase text-sm mb-3">{t(locale, 'about.eyebrow')}</p>
        <h1 class="reveal text-4xl md:text-5xl font-bold text-white leading-tight mb-6">
          {t(locale, 'hero.title')}
        </h1>
        <p class="reveal text-lg text-white/70 leading-relaxed">
          {t(locale, 'about.heroDesc', { legalName: siteConfig.legalName })}
        </p>
      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="border-b border-gray-100">
    <div class="container-yakeen py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {stats.map((stat, i) => (
          <div class="reveal text-center" style={`transition-delay: ${i * 60}ms`}>
            <div class="text-4xl md:text-5xl font-bold text-gradient-gold">{stat.value}</div>
            <div class="text-sm text-gray-500 mt-2 uppercase tracking-wide">{t(locale, stat.labelKey)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Story */}
  <section class="section-padding bg-white">
    <div class="container-yakeen">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{t(locale, 'about.story.eyebrow')}</p>
          <h2 class="text-3xl md:text-4xl font-bold text-navy-900 mb-6">{t(locale, 'about.story.title')}</h2>
          <div class="space-y-4 text-gray-700 leading-relaxed">
            <p>{t(locale, 'about.story.p1')}</p>
            <p>{t(locale, 'about.story.p2')}</p>
            <p>{t(locale, 'about.story.p3')}</p>
          </div>
        </div>
        <div class="reveal rounded-2xl overflow-hidden shadow-xl">
          <img src="/assets/images/showroom/mixed-showroom-display.jpg" alt={t(locale, 'about.eyebrow')} loading="lazy" width="600" height="400" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  {/* Factory Capability — ponytail: bilingual inline, no i18n keys needed */}
  <section class="section-padding bg-white">
    <div class="container-yakeen">
      <div class="text-center mb-12 reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{locale === 'ar' ? 'قدرات التصنيع' : 'Manufacturing Capability'}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-900">{locale === 'ar' ? 'شبكة المصانع الشركاء' : 'Partner Factory Network'}</h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          {locale === 'ar' ? 'مصانع متخصصة في فئات LED محددة، مع مراقبة جودة مستقلة في 5 مراحل وامتثال كامل لـ SASO/G-Mark.' : 'Specialized partner factories across China, each focused on specific LED categories. Independent 5-stage QC, full SASO/G-Mark compliance.'}
        </p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/smt-production-line.jpg" alt={locale === 'ar' ? 'خط إنتاج SMT' : 'SMT Production Line'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'خط إنتاج SMT' : 'SMT Production Line'}</p>
          </div>
        </div>
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/testing-laboratory.jpg" alt={locale === 'ar' ? 'مختبر الاختبار' : 'Testing Laboratory'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'مختبر الاختبار' : 'Testing Laboratory'}</p>
          </div>
        </div>
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/quality-control-inspection.jpg" alt={locale === 'ar' ? 'مراقبة الجودة' : 'Quality Control'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'مراقبة الجودة' : 'Quality Control'}</p>
          </div>
        </div>
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/warehouse-storage.jpg" alt={locale === 'ar' ? 'المستودع والخدمات اللوجستية' : 'Warehouse & Logistics'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'المستودع والخدمات اللوجستية' : 'Warehouse & Logistics'}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Packaging & Shipping — ponytail: reuse same grid pattern, 4 unused factory images, bilingual inline */}
  <section class="section-padding" style="background: var(--sand-50);">
    <div class="container-yakeen">
      <div class="text-center mb-12 reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{locale === 'ar' ? 'التعبئة والشحن' : 'Packaging & Shipping'}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-900">{locale === 'ar' ? 'من المصنع إلى ميناء الخليج' : 'From Factory to GCC Port'}</h2>
        <p class="text-gray-600 mt-4 max-w-2xl mx-auto">
          {locale === 'ar' ? 'تعبئة تصدير قياسية، تحميل حاويات آمن، وثائق شحن كاملة مع شهادات SASO. شحن بحري إلى موانئ الخليج خلال 20-35 يوماً.' : 'Export-grade packaging, secure container loading, and full shipping documentation with SASO certificates. Sea freight to GCC ports in 20–35 days.'}
        </p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/warehouse-packing.jpg" alt={locale === 'ar' ? 'تعبئة التصدير' : 'Export Packaging'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'تعبئة التصدير' : 'Export Packaging'}</p>
          </div>
        </div>
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/warehouse-stock.jpg" alt={locale === 'ar' ? 'المخزون والامتثال' : 'Stock & Fulfillment'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'المخزون والامتثال' : 'Stock & Fulfillment'}</p>
          </div>
        </div>
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/shipping-loading.jpg" alt={locale === 'ar' ? 'تحميل الحاويات' : 'Container Loading'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'تحميل الحاويات' : 'Container Loading'}</p>
          </div>
        </div>
        <div class="reveal rounded-xl overflow-hidden shadow-lg group">
          <div class="aspect-[4/3] overflow-hidden bg-navy-900">
            <img src="/assets/images/factory/showroom-prep.jpg" alt={locale === 'ar' ? 'الفحص قبل الشحن' : 'Pre-shipment Prep'} loading="lazy" width="400" height="300" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
          </div>
          <div class="p-3 bg-white">
            <p class="font-semibold text-navy-900 text-sm">{locale === 'ar' ? 'الفحص قبل الشحن' : 'Pre-shipment Prep'}</p>
          </div>
        </div>
      </div>
      {/* Shipping facts bar — ponytail: reuse stats grid pattern */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mt-10 pt-10 border-t border-gray-200">
        <div class="reveal text-center">
          <div class="text-3xl font-bold text-gradient-gold">15–30</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wide">{locale === 'ar' ? 'يوم إنتاج' : 'Days Production'}</div>
        </div>
        <div class="reveal text-center">
          <div class="text-3xl font-bold text-gradient-gold">20–35</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wide">{locale === 'ar' ? 'يوم شحن بحري' : 'Days Sea Freight'}</div>
        </div>
        <div class="reveal text-center">
          <div class="text-3xl font-bold text-gradient-gold">FOB/CIF/DDP</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wide">{locale === 'ar' ? 'شروط الشحن' : 'Shipping Terms'}</div>
        </div>
        <div class="reveal text-center">
          <div class="text-3xl font-bold text-gradient-gold">SASO</div>
          <div class="text-xs text-gray-500 mt-1 uppercase tracking-wide">{locale === 'ar' ? 'وثائق كاملة' : 'Full Docs'}</div>
        </div>
      </div>
    </div>
  </section>

  {/* Values */}
  <section class="section-padding" style="background: #f8f6f1;">
    <div class="container-yakeen">
      <div class="text-center mb-12 reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{t(locale, 'about.values.eyebrow')}</p>
        <h2 class="text-3xl md:text-4xl font-bold text-navy-900">{t(locale, 'about.values.title')}</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {values.map((value, i) => (
          <div class="reveal rounded-xl p-6 bg-white border border-gray-200 hover:border-gold-300 hover:shadow-lg transition-all" style={`transition-delay: ${i * 80}ms`}>
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 rounded-lg flex items-center justify-center" style="background: rgba(201,169,97,0.1);">
                <svg class="w-6 h-6 text-gold-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              </div>
              <div>
                <h3 class="font-bold text-navy-900 text-lg mb-2">{t(locale, value.titleKey)}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{t(locale, value.descKey)}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Founder */}
  <section class="section-padding bg-white">
    <div class="container-yakeen">
      <div class="max-w-3xl mx-auto text-center reveal">
        <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{t(locale, 'about.founder.eyebrow')}</p>
        <h2 class="text-3xl font-bold text-navy-900 mb-8">{t(locale, 'about.founder.name')}</h2>
        <div class="rounded-2xl p-8 border border-gray-200" style="background: #f8f6f1;">
          <p class="text-gray-700 leading-relaxed mb-4">
            "{t(locale, 'about.founder.quote1')}"
          </p>
          <p class="text-gray-700 leading-relaxed">
            "{t(locale, 'about.founder.quote2')}"
          </p>
          <p class="mt-6 font-bold text-navy-900">{t(locale, 'about.founder.attribution')}</p>
        </div>
      </div>
    </div>
  </section>

  <TrustBar />
  <CTABanner />
</BaseLayout>
