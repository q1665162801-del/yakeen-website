---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CTABanner from '../components/CTABanner.astro';
import { getAllProducts } from '../data/products';
import { productCategories, siteConfig } from '../data/site-config';
import { breadcrumbSchema } from '../utils/schema';
import { getLocale, t } from '../i18n/ui';

const locale = getLocale(Astro.url);
const prefix = locale === 'ar' ? '/ar' : '';

const products = await getAllProducts();

const crumbs = [
  { name: t(locale, 'nav.home'), url: prefix + '/' },
  { name: t(locale, 'products.breadcrumb.products'), url: prefix + '/products' },
];

const breadcrumbJsonLd = breadcrumbSchema(crumbs);
---

<BaseLayout
  title={t(locale, 'products.hero.title') + ' · Yakeen Lighting'}
  description={t(locale, 'products.hero.subtitle')}
  image="/assets/images/products/downlight-new.webp"
  canonicalPath="/products"
  type="page"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": t(locale, 'products.hero.title'),
    "description": t(locale, 'products.hero.subtitle'),
    "url": `${siteConfig.url}/products`,
    "numberOfItems": products.length,
    "itemListElement": products.map((p, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Product",
        name: p.name,
        description: p.metaDescription,
        url: `${siteConfig.url}/products/${p.slug}`,
        brand: { "@type": "Brand", name: "Yakeen Lighting" },
        image: `${siteConfig.url}${p.mainImage}`,
      },
    })),
  })} />

  {/* ===== Page Hero ===== */}
  <section class="relative overflow-hidden pt-32 pb-12 md:pt-40 md:pb-16" style="background: linear-gradient(135deg, #050b14 0%, #0a1525 50%, #1a2744 100%);">
    <div class="container-yakeen relative z-10">
      {/* Breadcrumb */}
      <nav class="text-sm text-white/60 mb-4" aria-label={t(locale, 'aria.breadcrumb')}>
        <a href={prefix + '/'} class="hover:text-gold-400 transition-colors">{t(locale, 'nav.home')}</a>
        <span class="mx-2 text-white/30">/</span>
        <span class="text-gold-400 font-medium">{t(locale, 'products.breadcrumb.products')}</span>
      </nav>

      <h1 class="reveal text-4xl md:text-5xl font-bold text-white leading-tight">
        {t(locale, 'products.hero.title')}
      </h1>
      <p class="reveal mt-4 text-lg text-white/70 max-w-2xl">
        {t(locale, 'products.hero.subtitle')}
      </p>
    </div>
  </section>

  {/* ===== Filter + Product Grid ===== */}
  <section class="section-padding bg-white">
    <div class="container-yakeen">
      {/* Filter bar */}
      <div class="flex flex-wrap items-center gap-2 mb-10" id="filter-bar" role="toolbar" aria-label={t(locale, 'aria.productFilter')}>
        <button type="button" data-filter="all" class="filter-btn active px-5 py-2 rounded-full text-sm font-semibold transition-all">
          {t(locale, 'products.filter.all')}
        </button>
        {productCategories.map((cat) => (
          <button type="button" data-filter={cat.id} class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-all">
            {t(locale, `products.filter.${cat.id}`)}
          </button>
        ))}
      </div>

      {/* Product grid */}
      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {products.map((product) => (
          <div data-category={product.category} class="product-item">
            <ProductCard product={product} />
          </div>
        ))}
      </div>

      {/* No results message (hidden by default) */}
      <div id="no-results" class="hidden text-center py-16">
        <p class="text-gray-500 text-lg">{t(locale, 'products.noResults')}</p>
        <button id="reset-filter" class="mt-4 btn-outline-gold">{t(locale, 'products.resetFilter')}</button>
      </div>
    </div>
  </section>

  {/* ===== OEM/ODM CTA ===== */}
  <section class="section-padding" style="background: #f8f6f1;">
    <div class="container-yakeen">
      <div class="grid md:grid-cols-2 gap-8 items-center">
        <div class="reveal">
          <p class="text-gold-600 font-semibold uppercase tracking-wide text-sm mb-2">{t(locale, 'products.oem.eyebrow')}</p>
          <h2 class="text-3xl font-bold text-navy-900 mb-4">{t(locale, 'products.oem.title')}</h2>
          <p class="text-gray-600 mb-6 leading-relaxed">
            {t(locale, 'products.oem.desc')}
          </p>
          <ul class="space-y-2 mb-6">
            {['f1', 'f2', 'f3', 'f4'].map((f) => (
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <svg class="w-5 h-5 text-gold-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {t(locale, `products.oem.${f}`)}
              </li>
            ))}
          </ul>
          <a href={prefix + '/contact'} class="btn-gold">{t(locale, 'products.oem.cta')}</a>
        </div>
        <div class="reveal rounded-2xl overflow-hidden shadow-xl">
          <img src="/assets/images/showroom/handshot/showroom-production-batch.jpg" alt={t(locale, 'products.oem.eyebrow')} loading="lazy" width="600" height="400" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>

<script is:inline>
  (function () {
    var buttons = document.querySelectorAll('[data-filter]');
    var items = document.querySelectorAll('[data-category]');
    var noResults = document.getElementById('no-results');
    var resetBtn = document.getElementById('reset-filter');
    var grid = document.getElementById('product-grid');

    function applyFilter(filter) {
      var visibleCount = 0;
      items.forEach(function (item) {
        var cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });
      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
      if (grid) {
        grid.classList.toggle('hidden', visibleCount === 0);
      }
    }

    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');
        applyFilter(btn.getAttribute('data-filter'));
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        buttons.forEach(function (b) { b.classList.remove('active'); });
        var allBtn = document.querySelector('[data-filter="all"]');
        if (allBtn) allBtn.classList.add('active');
        applyFilter('all');
      });
    }
  })();
</script>

<style>
  .filter-btn {
    background: #fff;
    border: 1px solid #e0d5c0;
    color: #2a4168;
    cursor: pointer;
  }
  .filter-btn:hover {
    border-color: #c9a961;
    color: #b8964a;
  }
  .filter-btn.active {
    background: #0a1525;
    border-color: #0a1525;
    color: #c9a961;
  }
</style>
