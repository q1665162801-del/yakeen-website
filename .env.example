# ─── Sanity CMS ──────────────────────────────────────────
# Get these from: sanity.io/manage → your project → API
# Required for build-time data fetching from Sanity Content Lake.
SANITY_PROJECT_ID=your_project_id_here
SANITY_DATASET=production

# ─── Sanity Import Script (scripts/import-to-sanity.mjs) ──
# Create a token with Editor role at: sanity.io/manage → API → Tokens
# Only needed locally for the one-time import. Do NOT commit.
SANITY_WRITE_TOKEN=your_write_token_here
